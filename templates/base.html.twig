<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}PENNYWORTH • Majordome de Wayne Manor & Opérateur Batcave{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Alfred Pennyworth — Intendance d'exception au Manoir Wayne le jour, logistique tactique à la Batcave la nuit.{% endblock %}">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.1em%22 font-size=%2296%22>🦇</text></svg>">

        {% block stylesheets %}
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
            <link rel="stylesheet" href="{{ asset('css/style.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="{% block body_class %}{% endblock %}">

        {# Bloc d'en-tête et navigation principale #}
        {% block header %}
            {% include '_partials/_header.html.twig' %}
        {% endblock %}

        {# Bloc optionnel pour l'en-tête des pages secondaires (Contact, Arsenal, À Propos) #}
        {% block page_banner %}{% endblock %}

        {# Contenu principal sans .container englobant afin de permettre les sections plein-écran #}
        <main class="site-main" id="main-content">
            {% block body %}{% endblock %}
        </main>

        {# Bloc de pied de page #}
        {% block footer %}
            {% include '_partials/_footer.html.twig' %}
        {% endblock %}

        {# Bloc des modales et effets globaux (Bat-Signal, vCard, Toast) #}
        {% block modals %}
            {% include '_partials/_modals.html.twig' %}
        {% endblock %}

    </body>
</html>
